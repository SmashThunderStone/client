{
  "name": "SmashCast",
  "short_name": "SmashCast",
  "description": "A client for the Farcaster protocol.",
  "background_color": "#0A0A0A",
  "categories": ["social"],
  "display": "standalone",
  "icons": [
    {
      "purpose": "any",
      "src": "brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "src": "brand/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/~/compose",
    "enctype": "multipart/form-data",
    "method": "POST",
    "params": {
      "text": "text"
    }
  },
  "start_url": ".",
  "theme_color": "#0A0A0A",
  "scope": "/",
  "protocols": {
    "farcaster": {
      "matches": "https://farcaster.xyz/*"
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
